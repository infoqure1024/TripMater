# Server
PORT=3000
HOST=0.0.0.0

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/tripmater
# Migration commands:
#   npm run migrate:up   — apply all pending migrations
#   npm run migrate:down — roll back ONE migration (safe default)
#                          To roll back N migrations, run migrate:down N times.

# Auth (required)
ADMIN_API_KEY=your-admin-api-key-here

# Logging
LOG_LEVEL=info
